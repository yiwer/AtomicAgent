{
  "name": "atomicagent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:run": "tsx --test tests/runs.test.ts",
    "test:browser": "playwright test",
    "setup:local": "tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "0.1.11",
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
